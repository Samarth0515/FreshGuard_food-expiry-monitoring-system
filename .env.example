# ==============================================================================
# FreshGuard Environment Configuration Template
# Copy this file to .env and configure your local/production values.
# DO NOT commit .env to version control!
# ==============================================================================

# Server Configuration
PORT=8080

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/freshguard?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Security (Generate a secure 256-bit or 512-bit hex secret for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
JWT_EXPIRY_MS=86400000

# Administrator Default Credentials
ADMIN_DEFAULT_PASSWORD=your_admin_secure_password_here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
